# B站Cookie（可选，用于下载需要登录的视频）
BILIBILI_COOKIE=

# Qwen ASR模型路径（可选，默认从HuggingFace下载）
QWEN_ASR_MODEL_PATH=

# LLM后端配置（openai / local）
LLM_PROVIDER=openai

# OpenAI API配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 服务配置
PORT=8000
LOG_LEVEL=info

# 结果存储目录
RESULT_DIR=./results

# STT后端配置 (default/local/remote)
# default: 优先本地，失败fallback远程
# local: 仅本地
# remote: 仅远程
STT_BACKEND=default
STT_API_URL=
STT_API_KEY=

# STT分块时长(秒)，避免长音频显存溢出，0=使用模型默认(1200s)
# 0.6B模型(5.6GB显存): 建议0(不启用)或600
# 1.7B模型(5.6GB显存): 建议120-180
STT_CHUNK_DURATION=0
